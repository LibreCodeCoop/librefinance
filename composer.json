{
  "name": "librecodecoop/librefinance",
  "description": "Independent free collaborative financial infrastructure for Nextcloud",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "OCA\\LibreFinance\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\LibreFinance\\Tests\\Unit\\": "tests/unit/"
    }
  },
  "scripts": {
    "lint": "find appinfo lib -type f -name '*.php' -print0 | xargs -0 -n 1 php -l",
    "test:unit": "phpunit --configuration phpunit.xml --testsuite unit --no-coverage",
    "openapi": "@php tests/openapi/generate.php",
    "openapi:check": "@php tests/openapi/generate.php --check"
  }
}
