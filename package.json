{
  "name": "librefinance",
  "private": true,
  "version": "0.18.11",
  "type": "module",
  "scripts": {
    "build": "vite build && mkdir -p css && mv js/style.css css/main.css && vite build --config vite.admin.config.js && mv js/admin-style.css css/admin.css",
    "dev": "vite build --watch",
    "test": "node --test tests/frontend/*.test.mjs",
    "test:e2e": "playwright test",
    "test:openapi": "node tests/openapi/validate.mjs",
    "generate:openapi": "php tests/openapi/generate.php",
    "check:openapi": "php tests/openapi/generate.php --check"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "9.14.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "webdav": {
      "minimatch": "11.0.1"
    }
  }
}
